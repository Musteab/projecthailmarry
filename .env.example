# Copy to .env (git-ignored) and fill in. Never commit real keys.

# --- server (apps/server) ---
# API_PORT (not PORT) so it never collides with the web dev server's port
API_PORT=8787
# 127.0.0.1 for local development; 0.0.0.0 in a deployment
API_HOST=127.0.0.1
CORS_ORIGIN=http://localhost:5173
DATABASE_PATH=./.data/bastion.sqlite
# Both have development-only defaults built in, so local development needs neither.
# A production start (NODE_ENV=production) refuses to run unless both are set here.
# JWT_SECRET must be at least 32 characters; SEED_DEMO_PASSWORD at least 8.
JWT_SECRET=
# Password shared by the five seeded demo accounts (admin@, operator@, coordinator@,
# utility@, observer@bastion.demo). Development default: bastion-demo
SEED_DEMO_PASSWORD=
# Folder holding regions/ and scenarios/ (relative paths are resolved from the repo root)
DATA_DIR=./data
# Falls back to the built-in test region when this pack has not been built yet
REGION_ID=portland
LOG_LEVEL=info
# Serve the built web app (apps/web/dist) from the server. On by default when
# NODE_ENV=production, off otherwise; set true or false to override. Run `pnpm build` first.
SERVE_WEB=
WEB_DIST_DIR=./apps/web/dist

# --- intel (packages/intel) ---
ANTHROPIC_API_KEY=
# live = call the API, cache = cached responses only, off = rule-based fallback
INTEL_MODE=off
INTEL_MODEL_FAST=claude-sonnet-5-5
INTEL_MODEL_DEEP=claude-fable-5-2
FEEDS_ENABLED=false

# --- web (apps/web), read by Vite from the repo root ---
VITE_MAPBOX_TOKEN=
# leave empty to use the dev proxy / same origin
VITE_API_URL=
VITE_WS_URL=
